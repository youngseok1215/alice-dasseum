# 다씀 백엔드 환경변수 예시 — 이 파일을 backend/.env 로 복사해 값을 채우세요.
# backend/.env 는 .gitignore에 포함되어 있어 커밋되지 않습니다. 실제 키를 이 예시 파일에 적지 마세요.
# 실행: node --env-file=backend/.env backend/server.mjs   (저장소 루트에서, Node 22.13 이상)

# ── AI (필수) ─────────────────────────────────────────────
# 사진 제품 인식 + 구매 전 유사 제품 임베딩 분석. 없으면 두 기능이 503을 반환합니다.
GEMINI_API_KEY=

# ── 인터넷 제품 사진 추천 (권장) ───────────────────────────
# 없으면 추천 사진 없이 촬영·앨범 사진만 선택할 수 있습니다.
KAKAO_REST_API_KEY=

# ── 선택 ──────────────────────────────────────────────────
# 카카오 키가 없을 때 사진 기반 유사 이미지 검색에 사용
GOOGLE_CLOUD_VISION_API_KEY=
# 엘리스 LLM으로 구매 판단 문구 생성 (세 값 모두 있어야 사용)
ELICE_VISION_ENDPOINT=
ELICE_VISION_MODEL=
ELICE_VISION_API_KEY=

# ── 서버 ──────────────────────────────────────────────────
# 휴대폰·외부에서 접속하려면 0.0.0.0. 비우면 127.0.0.1(이 컴퓨터만), 단 PORT만 설정된 배포 환경에서는 0.0.0.0
DASSEM_HOST=0.0.0.0
# 비우면 PORT, 그것도 없으면 3001
DASSEM_PORT=3001

# SQLite 파일 경로. 사진은 같은 폴더의 images/ 에 저장됩니다.
# 배포 시 반드시 영구 디스크(볼륨) 안의 경로로 지정하세요. 비우면 backend/.data/products.sqlite
DASSEM_DB_PATH=

# 웹 빌드에서 접속을 허용할 주소(쉼표 구분). 휴대폰 앱은 필요 없습니다. localhost는 항상 허용.
# 예: https://dasseum.example.com
DASSEM_CORS_ORIGINS=
